# ============================================
# WhatsApp AI Sales Agent - Environment Config
# ============================================

# --- Meta WhatsApp Business API ---
WHATSAPP_API_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token

# --- AI Engine (Claude - Primary) ---
ANTHROPIC_API_KEY=your_anthropic_api_key
AI_MODEL=claude-sonnet-4-6

# --- AI Engine (OpenAI - Fallback) ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# --- PostgreSQL (Direct - Self-Hosted K8s) ---
DB_HOST=postgres-service
DB_PORT=5432
DB_NAME=whatsapp_agent
DB_USER=postgres
DB_PASSWORD=postgres

# --- Application ---
APP_NAME=WhatsApp AI Sales Agent
APP_ENV=development
APP_SECRET_KEY=generate_a_random_secret_key_here
APP_PORT=8000
APP_HOST=0.0.0.0
DASHBOARD_PASSWORD=your_dashboard_password

# --- Business Configuration ---
BUSINESS_NAME=Your Business Name
BUSINESS_DESCRIPTION=Brief description of your products/services
BUSINESS_WEBSITE=https://yourbusiness.com
CURRENCY=INR
TIMEZONE=Asia/Kolkata

# --- Webhook ---
WEBHOOK_URL=https://your-domain/api/webhook
