# ─────────────────────────────────────────────────────────────
# Santhira Platform Environment Configuration
# Copy this file to .env and fill in your real API keys.
# NEVER commit .env to git — it's in .gitignore
# ─────────────────────────────────────────────────────────────

# ── Application Settings ──────────────────────────────────────
APP_NAME=Santhira DevOps Platform
APP_ENV=development               # development | staging | production
APP_PORT=8001
DEBUG=true
SECRET_KEY=changeme-use-a-long-random-string-here

# ── AI / LLM API Keys ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here          # Claude 3.7 Sonnet
OPENAI_API_KEY=sk-your-openai-key-here          # GPT-4o / TTS
GOOGLE_GEMINI_API_KEY=AIza-your-gemini-key-here # Gemini 1.5 Pro / TTS

# ── Supabase (Vector DB + Auth + Storage) ────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── PostgreSQL (Local / Supabase direct connection) ───────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/santhira
PGVECTOR_ENABLED=true

# ── n8n Orchestration Webhooks ───────────────────────────────
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_PODCAST=http://localhost:5678/webhook/generate-podcast
N8N_WEBHOOK_REMEDIATION=http://localhost:5678/webhook/trigger-remediation

# ── Cloudflare (Auto-remediation) ────────────────────────────
CF_ZONE_ID=your-cloudflare-zone-id
CF_API_KEY=your-cloudflare-api-key

# ── Sentry (Error Monitoring) ────────────────────────────────
SENTRY_DSN=https://your-dsn@sentry.io/project-id

# ── LiveKit (Voice AI) ───────────────────────────────────────
LIVEKIT_URL=wss://your-livekit-server
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
