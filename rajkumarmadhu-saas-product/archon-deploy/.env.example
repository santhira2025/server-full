# Database (using host PostgreSQL via host.docker.internal)
POSTGRES_PASSWORD=archon_secret

# Frontend URL (used by API for CORS)
FRONTEND_URL=http://localhost:8080

# API URL (baked into frontend at build time)
VITE_API_URL=http://localhost:3000

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# Stripe (optional, leave blank to disable billing)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
