# ============================================
# HRAssist Production Environment Variables
# ============================================

# Registry
REGISTRY=ghcr.io/your-org
TAG=latest

# Database
DB_USER=hrms_admin
DB_PASSWORD=your-secure-db-password
DB_NAME=hrms_db

# JWT
JWT_SECRET=your-super-secure-jwt-secret-at-least-32-chars

# n8n
N8N_USER=admin
N8N_PASSWORD=your-secure-n8n-password

# Optional: Cloud AI APIs (leave empty to use self-hosted)
# OPENAI_API_KEY=sk-your-openai-key
# ELEVENLABS_API_KEY=your-elevenlabs-key

# Domain
DOMAIN=hrassist.rmadhu.in
