{
  "name": "archon-api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "tunnel": "tsx src/tunnel.ts",
    "tunnel:cli": "smee -u https://smee.io/Cvwd5grsATZOrsxa -p 3000 -P /webhook/github",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test:auth": "tsx tests/test-auth.ts",
    "test:webhooks": "tsx tests/test-webhooks.ts",
    "test:dedup": "tsx tests/test-dedup.ts",
    "test:all": "tsx tests/test-webhooks.ts && tsx tests/test-auth.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@octokit/graphql": "^9.0.3",
    "@octokit/rest": "^22.0.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.3",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "octokit": "^5.0.5",
    "pg": "^8.19.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "stripe": "^20.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.34",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0",
    "@vitest/coverage-v8": "^4.0.18",
    "drizzle-kit": "^0.31.9",
    "pino-pretty": "^13.1.3",
    "smee-client": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18"
  }
}
